          <w:p w14:paraId="364FBD4B" w14:textId="77777777" w:rsidR="00A606F9" w:rsidRDefault="00A606F9" w:rsidP="00A606F9">
            <w:pPr>
              <w:spacing w:line="276" w:lineRule="auto"/>
              <w:rPr>
                <w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/>
                <w:sz w:val="22"/>
                <w:szCs w:val="22"/>
                <w:lang w:val="de-DE"/>
              </w:rPr>
            </w:pPr>
            <w:r>
              <w:rPr>
                <w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/>
                <w:sz w:val="22"/>
                <w:szCs w:val="22"/>
                <w:lang w:val="de-DE"/>
              </w:rPr>
              <w:t xml:space="preserve">Vertikales Platformer-Webgame mit Levelstruktur, realisiert in HTML5-Canvas und Vanilla JavaScript mit einer handgezeichneten 2D-Optik.</w:t>
            </w:r>
          </w:p>
          <w:p w14:paraId="0CBAD987" w14:textId="77777777" w:rsidR="00A606F9" w:rsidRDefault="00A606F9" w:rsidP="00A606F9">
            <w:pPr>
              <w:spacing w:line="276" w:lineRule="auto"/>
              <w:rPr>
                <w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/>
                <w:sz w:val="22"/>
                <w:szCs w:val="22"/>
                <w:lang w:val="de-DE"/>
              </w:rPr>
            </w:pPr>
          </w:p>
          <w:p w14:paraId="347F3285" w14:textId="39F301C8" w:rsidR="00A606F9" w:rsidRDefault="00A606F9" w:rsidP="00A606F9">
            <w:pPr>
              <w:spacing w:line="276" w:lineRule="auto"/>
              <w:rPr>
                <w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/>
                <w:sz w:val="22"/>
                <w:szCs w:val="22"/>
                <w:lang w:val="de-DE"/>
              </w:rPr>
            </w:pPr>
            <w:r>
              <w:rPr>
                <w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/>
                <w:sz w:val="22"/>
                <w:szCs w:val="22"/>
                <w:lang w:val="de-DE"/>
              </w:rPr>
              <w:t xml:space="preserve">Das Spiel ist zeitbasiert: Der Spieler steuert eine Katze, die automatisch auf Plattformen springt und dabei einem steigenden Wasserstand nach oben ausweicht. Plattformen werden prozedural generiert. Das Spiel ist in Level unterteilt: Jedes Level hat ein definiertes Höhenziel – wird es erreicht, folgt ein Score-Screen und das nächste Level beginnt.</w:t>
            </w:r>
          </w:p>
          <w:p w14:paraId="3FB34E61" w14:textId="77777777" w:rsidR="00A606F9" w:rsidRDefault="00A606F9" w:rsidP="00A606F9">
            <w:pPr>
              <w:spacing w:line="276" w:lineRule="auto"/>
              <w:rPr>
                <w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/>
                <w:sz w:val="22"/>
                <w:szCs w:val="22"/>
                <w:lang w:val="de-DE"/>
              </w:rPr>
            </w:pPr>
          </w:p>
          <w:p w14:paraId="199D56C1" w14:textId="1B53621E" w:rsidR="00A606F9" w:rsidRDefault="00A606F9" w:rsidP="00A606F9">
            <w:pPr>
              <w:spacing w:line="276" w:lineRule="auto"/>
              <w:rPr>
                <w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/>
                <w:sz w:val="22"/>
                <w:szCs w:val="22"/>
                <w:lang w:val="de-DE"/>
              </w:rPr>
            </w:pPr>
            <w:r>
              <w:rPr>
                <w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/>
                <w:sz w:val="22"/>
                <w:szCs w:val="22"/>
                <w:lang w:val="de-DE"/>
              </w:rPr>
              <w:t xml:space="preserve">Das Spiel verfügt über ein Lebenssystem mit drei Herzen. Berührt der Spieler das Wasser, verliert er ein Leben. Als aktive Fähigkeit kann die Katze Objekte nach unten werfen, um mit dem Wasser zu interagieren. Der erreichte Höchststand wird als Punktzahl gewertet und lokal im Browser gespeichert.</w:t>
            </w:r>
          </w:p>
          <w:p w14:paraId="159DBEA2" w14:textId="77777777" w:rsidR="00A606F9" w:rsidRDefault="00A606F9" w:rsidP="00A606F9">
            <w:pPr>
              <w:spacing w:line="276" w:lineRule="auto"/>
              <w:rPr>
                <w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/>
                <w:sz w:val="22"/>
                <w:szCs w:val="22"/>
                <w:lang w:val="de-DE"/>
              </w:rPr>
            </w:pPr>
          </w:p>
          <w:p w14:paraId="24C31FE6" w14:textId="23894328" w:rsidR="00FD31FA" w:rsidRPr="00BF045D" w:rsidRDefault="00A606F9" w:rsidP="00A606F9">
            <w:pPr>
              <w:spacing w:line="276" w:lineRule="auto"/>
              <w:rPr>
                <w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/>
                <w:b/>
                <w:sz w:val="24"/>
                <w:szCs w:val="24"/>
                <w:lang w:val="de-DE"/>
              </w:rPr>
            </w:pPr>
            <w:r>
              <w:rPr>
                <w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/>
                <w:sz w:val="22"/>
                <w:szCs w:val="22"/>
                <w:lang w:val="de-DE"/>
              </w:rPr>
              <w:t>Zum Lieferumfang gehören das spielbare Webgame (gehostet über GitHub Pages), ein Game Design Document sowie eine Gameplay-Videosequenz.</w:t>
            </w:r>
          </w:p>
